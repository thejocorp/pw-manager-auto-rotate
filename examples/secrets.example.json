{
  "bitwarden": {
    "organization": "Homelab",
    "collection": "Servers"
  },
  "secrets": [
    {
      "name": "myapp/api-key",
      "kind": "generated",
      "bytes": 32,
      "places": [
        {
          "host": "local",
          "file": "/etc/myapp/app.env",
          "format": "env",
          "key": "API_KEY",
          "mode": "600"
        },
        {
          "host": "ssh:deploy@web2.example",
          "file": "/etc/myapp/app.env",
          "format": "env",
          "key": "API_KEY"
        }
      ],
      "restart": [
        {
          "host": "local",
          "cmd": "systemctl restart myapp"
        },
        {
          "host": "ssh:deploy@web2.example",
          "cmd": "systemctl restart myapp"
        }
      ],
      "check": [
        {
          "host": "local",
          "cmd": "curl -fsS http://127.0.0.1:8080/health"
        }
      ]
    },
    {
      "name": "myapp/db-password",
      "kind": "generated",
      "places": [
        {
          "host": "local",
          "file": "/etc/myapp/config.json",
          "format": "json",
          "key": "database.password"
        }
      ],
      "restart": [
        {
          "host": "local",
          "cmd": "systemctl restart myapp"
        }
      ]
    }
  ]
}
